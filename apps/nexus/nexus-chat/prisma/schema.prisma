// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Conversation {
  id          String    @id @default(cuid())
  title       String    @default("New Conversation")
  systemPrompt String?
  pinned      Boolean   @default(false)
  archived    Boolean   @default(false)
  model       String    @default("default")
  temperature Float     @default(0.7)
  tags        String    @default("[]") // JSON array of tag strings
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  messages    Message[]

  @@index([pinned, updatedAt])
  @@index([archived])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // 'user' | 'assistant' | 'system'
  content        String
  type           String   @default("text") // 'text' | 'image' | 'audio' | 'search' | 'image-gen' | 'vision'
  metadata       String?  // JSON string for attachments, search results, etc.
  reaction       String?  // 'up' | 'down' | null
  bookmarked     Boolean  @default(false)
  tokens         Int?
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([bookmarked])
}

model PromptTemplate {
  id          String   @id @default(cuid())
  title       String
  description String
  content     String
  category    String   @default("general")
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model SystemPrompt {
  id          String   @id @default(cuid())
  title       String
  content     String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isDefault])
}

model GeneratedImage {
  id          String   @id @default(cuid())
  prompt      String
  base64      String
  size        String   @default("1024x1024")
  conversationId String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([conversationId])
}

model UserSettings {
  id           String  @id @default("default")
  theme        String  @default("system") // 'light' | 'dark' | 'system'
  defaultModel String  @default("default")
  temperature  Float   @default(0.7)
  systemPrompt String  @default("You are Nexus AI, a helpful, knowledgeable and friendly AI assistant. Respond in the user's language. Use markdown formatting when appropriate.")
  ttsVoice     String  @default("tongtong")
  ttsSpeed     Float   @default(1.0)
  ttsEnabled   Boolean @default(false)
  streamingEnabled Boolean @default(true)
  maxHistoryMessages Int @default(20)
  // RGPD/LOPDGDD - Cumplimiento protección de datos
  timezone     String  @default("Europe/Madrid") // Zona horaria España
  locale       String  @default("es-ES") // Localización España
  dataRetentionDays Int @default(365) // Política retención de datos (días)
  analyticsEnabled Boolean @default(false) // Consentimiento analíticas
  marketingEnabled  Boolean @default(false) // Consentimiento marketing
  consentDate  DateTime? // Fecha consentimiento RGPD
  consentVersion String? // Versión política de privacidad aceptada
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String   // 'CREATE' | 'READ' | 'UPDATE' | 'DELETE' | 'EXPORT' | 'LOGIN' | 'LOGOUT'
  resource    String   // 'conversation' | 'message' | 'settings' | 'bookmark' | 'tag'
  resourceId  String?
  userId      String   @default("anonymous") // En futuro: usuario autenticado
  ipAddress   String?
  userAgent   String?
  metadata    String?  // JSON con detalles adicionales
  timestamp   DateTime @default(now())

  @@index([action, timestamp])
  @@index([resource, timestamp])
  @@index([userId])
}

model CookieConsent {
  id              String   @id @default(cuid())
  necessary       Boolean  @default(true)  // Siempre true (técnicas)
  preferences     Boolean  @default(false) // Preferencias
  analytics       Boolean  @default(false) // Analíticas
  marketing       Boolean  @default(false) // Marketing
  ipAddress       String?
  userAgent       String?
  consentDate     DateTime @default(now())
  lastUpdated     DateTime @updatedAt
  policyVersion   String   @default("1.0")

  @@index([consentDate])
}
