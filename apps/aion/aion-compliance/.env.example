# Copia este archivo a `.env` y rellena tus claves reales.
# NUNCA subas `.env` a un repositorio.
# Este archivo de ejemplo NO contiene claves reales.

# Groq (Llama 3.3 70B, Mistral)
GROQ_API_KEY=tu_groq_key

# OpenRouter (multi-model)
OPENROUTER_API_KEY=tu_openrouter_key

# NVIDIA NIM
NVIDIA_API_KEY=tu_nvidia_key

# Google Gemini
GOOGLE_API_KEY=tu_google_key

# OpenAI
OPENAI_API_KEY=tu_openai_key

# Cerebras
CEREBRAS_API_KEY=tu_cerebras_key

# DeepSeek
DEEPSEEK_API_KEY=tu_deepseek_key

# DashScope/Qwen
DASHSCOPE_API_KEY=tu_dashscope_key
